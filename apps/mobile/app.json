{
  "expo": {
    "name": "Thôn Thống Nhất",
    "slug": "thon-thong-nhat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thonthongnhat",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "vn.thonthongnhat.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3BA56A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.thonthongnhat.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3BA56A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng dùng vị trí để gửi kèm khi bạn bấm KHẨN CẤP hoặc gửi phản ánh, giúp cán bộ thôn tìm đến nhanh hơn."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập ảnh để bạn đính kèm ảnh khi gửi phản ánh.",
          "cameraPermission": "Ứng dụng cần dùng camera để bạn chụp ảnh sự cố khi gửi phản ánh."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3BA56A",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
